{
  // Scoped markdownlint config for the demo vault. The notes are the plugin's
  // documentation, so they are linted like documentation; only the fixtures
  // under `_assets/` are exempt.
  "config": {
    // `[[wikilinks]]` are Obsidian's native link syntax; markdownlint parses
    // them as undefined shortcut reference links. Notes link each other with
    // `[Text](<./NN Name.md>)` (wikilinks do not render on GitHub), so the only
    // remaining `[[...]]` are inside the code fences of `08 Wikilinks.md`,
    // which markdownlint already ignores. Kept off so that note can keep
    // demonstrating the syntax without a suppression comment.
    "MD052": false
  },
  // `_assets/` holds code fixtures, not documentation: `code-script` modules,
  // Templater templates, and a vendored `node_modules`. They are notes only by
  // file extension and have no headings, so `MD041` does not apply to them.
  "ignores": [
    "_assets/**"
  ]
}
